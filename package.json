{
  "name": "guardpay-monorepo",
  "version": "1.0.0",
  "description": "Policy-Bound Autonomous AI Agent Wallets with PayPal Developer Platform & AG Grid Telemetry",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:dashboard": "npm --workspace=dashboard run dev",
    "dev:mcp": "npm --workspace=mcp-server run dev",
    "demo:agent": "npm --workspace=backend run simulate",
    "dev": "npm run dev:backend",
    "build": "npm --workspaces run build"
  },
  "keywords": [
    "paypal",
    "ai-agents",
    "agentic-commerce",
    "mcp",
    "ag-grid",
    "render",
    "fintech"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.7.2"
  },
  "author": "GuardPay Team",
  "license": "MIT"
}
